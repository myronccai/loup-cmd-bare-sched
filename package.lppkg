# The scheduler kernel for x86_64 (QEMU pc). Build it with
#   loup build --target freestanding --arch x86_64
# The aarch64 kernel and the two self-test images have their own manifests
# under boards/.
name = "sched"
version = "0.1.0"
loup = "1.26.0"
authors = []

[build]
entry = "source/main_x86_64.lpfree"
target = "freestanding"
mode = "freestanding"
arch = "x86_64"
panic = "custom"

[linker]
script = "linker/x86_64.ld"
entry = "_start"

[freestanding]
stack_size = 65536
bounds = "trap"
overlays = "error"
rawpoke = "unsafe-only"
