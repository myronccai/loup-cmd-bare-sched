# The scheduler kernel for aarch64 (QEMU virt). Build it with
#   loup build --target freestanding --arch aarch64 boards/aarch64
# Paths are relative to this directory.
name = "sched"
version = "0.1.0"
loup = "1.26.0"
authors = []

[build]
entry = "../../source/main_aarch64.lpfree"
target = "freestanding"
mode = "freestanding"
arch = "aarch64"
panic = "custom"

[linker]
script = "../../linker/aarch64.ld"
entry = "_start"

[freestanding]
stack_size = 65536
bounds = "trap"
overlays = "error"
rawpoke = "unsafe-only"
