@mode(host.dual)

from debug.assert import (expectEq);
from commands.hello import (greeting_message);

func test_plain_greeting(): void {
    expectEq(greeting_message("Hello", "world", false), "Hello, world!", "plain");
}

func test_shouted_greeting(): void {
    expectEq(greeting_message("Hi", "Ann", true), "HI, ANN!", "shout");
}
