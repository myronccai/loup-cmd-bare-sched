@mode(host.dual)

# Command-line parsing. Loup 1.26 has no CLI library, so arguments are
# parsed by hand into an Options value.
#
# Grammar: [OPTIONS] COMMAND [OPERANDS...]
#   Options may appear anywhere before `--`; everything after `--` is an
#   operand. Value options accept `--name VALUE` and `--name=VALUE`.

pub const DEFAULT_GREETING: string = "Hello";

pub struct Options {
    pub command: string;
    pub operands: list[string];
    pub help: bool;
    pub version: bool;
    pub verbose: bool;
    pub shout: bool;
    pub greeting: string;
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    var command = "";
    var operands: list[string] = [];
    var help = false;
    var version = false;
    var verbose = false;
    var shout = false;
    var greeting = DEFAULT_GREETING;
    var only_operands = false;

    var i = 0;
    while (i < argv.len()) {
        let arg = argv[i];
        i += 1;

        if (only_operands or arg == "-" or !arg.startsWith("-")) {
            if (command.is_empty()) {
                command = arg;
            } else {
                operands.push(arg);
            }
            continue;
        }
        if (arg == "--") {
            only_operands = true;
            continue;
        }

        # Split `--name=value` into its name and inline value.
        var name = arg;
        var inline_value: Option[string] = None;
        if (arg.startsWith("--") and arg.contains("=")) {
            let parts = arg.split("=");
            name = parts[0];
            inline_value = Some(parts.slice(1).join("="));
        }

        if (name == "-g" or name == "--greeting") {
            match inline_value {
                Some(v) => { greeting = v; },
                None => {
                    if (i >= argv.len()) {
                        return Err(i"option '{$ name $}' requires a value");
                    }
                    greeting = argv[i];
                    i += 1;
                },
            }
            continue;
        }

        if (inline_value.is_some()) {
            return Err(i"option '{$ name $}' does not take a value");
        }
        if (name == "-h" or name == "--help") {
            help = true;
        } else if (name == "-V" or name == "--version") {
            version = true;
        } else if (name == "-v" or name == "--verbose") {
            verbose = true;
        } else if (name == "--shout") {
            shout = true;
        } else {
            return Err(i"unknown option '{$ name $}'");
        }
    }

    return Ok(Options(
        command = command,
        operands = operands,
        help = help,
        version = version,
        verbose = verbose,
        shout = shout,
        greeting = greeting,
    ));
}
