@mode(freestanding)

# The scheduler kernel's entry on x86_64: attach the console, build the
# board, hand over to the demo.
#
# Runtime: freestanding, x86_64 only. The entry file of package.lppkg:
# `make build` compiles it, with the modules it imports, into the
# bare-metal image build/sched-x86_64.elf (`loup build --target
# freestanding --arch x86_64`); there is no operating system, runtime
# library, heap or exceptions. `make boot` boots it on QEMU's pc machine
# (scripts/qemu.sh), waits for the demo, types keys and compares the
# transcripts with tests/expected/; `make run` boots it on this terminal.
# `make check` type-checks it with Stage0.

from kernel.console import (attach);
from x86.com1 import (com1Init, com1Put);
from x86.board import (pcBoard);
from demo.run import (runKernel);

# _start (x86/board.lpfree) calls it by name, on the boot stack, in long
# mode with interrupts masked.
func kernelMain(): void {
    com1Init();
    attach(com1Put);
    runKernel(pcBoard());
}
