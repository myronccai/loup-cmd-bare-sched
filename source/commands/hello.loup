@mode(host.dual)

# The sample `hello` command. Replace it with the application's own
# commands; each command takes the parsed Options and returns an exit status.

from appinfo import (APP_NAME, EXIT_OK, EXIT_USAGE);
from cli.args import (Options);

pub func greeting_message(greeting: string, name: string, shout: bool): string {
    let text = i"{$ greeting $}, {$ name $}!";
    return if (shout) { text.to_uppercase() } else { text };
}

pub func run_hello(opts: Options): int {
    if (opts.operands.len() > 1) {
        printErr(i"{$ APP_NAME $}: hello takes at most one NAME");
        return EXIT_USAGE;
    }
    let name = if (opts.operands.len() == 0) { "world" } else { opts.operands[0] };
    println(greeting_message(opts.greeting, name, opts.shout));
    return EXIT_OK;
}
