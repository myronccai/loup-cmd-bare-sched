@mode(freestanding)

# The PL011 UART of QEMU's virt machine (at 0x09000000, interrupt INTID
# 33): the console. Output is polled; input raises an interrupt for every
# byte received.
#
# Runtime: freestanding, aarch64 only. The arm board module imports it, so
# `make build` compiles it into build/sched-aarch64.elf and
# build/selftest-aarch64.elf (`loup build --target freestanding --arch
# aarch64 boards/...`); the x86_64 images never contain it. It runs when
# `make boot` boots those images on QEMU's virt machine (Cortex-A53);
# `make check` type-checks it with Stage0 from boards/aarch64.

const UART: uint64 = 0x09000000u64;

# 32-bit registers, as offsets from UART.
const DATA: uint64 = 0x000u64;
const FLAGS: uint64 = 0x018u64;
const MASK: uint64 = 0x038u64;
const CLEAR: uint64 = 0x044u64;

const FLAG_RX_EMPTY: uint32 = 0x10u32;
const FLAG_TX_FULL: uint32 = 0x20u32;
const INT_RECEIVE: uint32 = 0x10u32;

@interruptSafe
func readRegister(offset: uint64): uint32 {
    return Volatile[uint32, Little].at(UART + offset).read();
}

@interruptSafe
func writeRegister(offset: uint64, value: uint32): void {
    Volatile[uint32, Little].at(UART + offset).write(value);
}

## Unmasks the receive interrupt (QEMU starts the UART enabled, 8N1).
pub func pl011EnableReceive(): void {
    writeRegister(CLEAR, 0x7FFu32);
    writeRegister(MASK, INT_RECEIVE);
}

## Writes one byte, waiting while the transmit FIFO is full.
pub func pl011Put(c: uint8): void {
    while ((readRegister(FLAGS) & FLAG_TX_FULL) != 0u32) {
    }
    writeRegister(DATA, c as uint32);
}

@interruptSafe
pub func pl011HasByte(): bool {
    return (readRegister(FLAGS) & FLAG_RX_EMPTY) == 0u32;
}

## The next received byte; reading it also clears the receive interrupt.
@interruptSafe
pub func pl011Take(): uint8 {
    return (readRegister(DATA) & 0xFFu32) as uint8;
}
