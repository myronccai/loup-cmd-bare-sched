@mode(freestanding)

# The aarch64 self-test image: runs the kernel's unit tests
# (selftest/tests.lpfree) on the bare machine and reports through the
# PL011.
#
# Runtime: freestanding, aarch64 only. The entry file of
# boards/selftest-aarch64/package.lppkg: `make build` compiles it, with the
# modules under test and the arm board, into build/selftest-aarch64.elf
# (`loup build --target freestanding --arch aarch64
# boards/selftest-aarch64`). `make boot` boots it on QEMU's virt machine
# and compares the report with tests/expected/selftest-aarch64.txt; QEMU
# exits with 0 when every test passes, 1 when one fails. `make check`
# type-checks it with Stage0.

from kernel.console import (attach);
from arm.pl011 import (pl011Put);
from arm.board import (virtBoard);
from selftest.tests import (runAll);

# Called by name from _start (arm/board.lpfree), as in the scheduler image.
func kernelMain(): void {
    attach(pl011Put);
    let board = virtBoard();
    board.halt(runAll(board, pl011Put));
}
